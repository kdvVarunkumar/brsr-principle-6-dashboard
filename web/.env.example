# Copy to .env (which git ignores) and fill in. The key stays on the runtime server; it never reaches the browser.
# Free Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-key-here

# Optional: another model or provider (then use that provider's key variable, e.g. OPENAI_API_KEY or ANTHROPIC_API_KEY).
# COPILOT_MODEL=google/gemini-3.5-flash
# COPILOT_MODEL=openai:gpt-5-mini
# COPILOT_MODEL=anthropic:claude-sonnet-5-5
# Where the Python data service (python flow.py serve) listens.
# BRSR_API_URL=http://127.0.0.1:8000

# CopilotKit sends anonymous usage statistics by default; this switches that off.
COPILOTKIT_TELEMETRY_DISABLED=true
